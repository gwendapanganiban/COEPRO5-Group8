        if int(widget.grid_info()["row"]) > 0:
            widget.destroy()
    process_entries.clear()
    
    try:
        n = int(num_process.get())
        if n <= 0: raise ValueError
            
        for i in range(n):
            tk.Label(input_frame, text=f"P{i+1}").grid(row=i+1, column=0, pady=2)
            
            arr_ent = tk.Entry(input_frame, width=15)
            arr_ent.insert(0, "0") # Default values for faster testing
            arr_ent.grid(row=i+1, column=1, pady=2)
            
            burst_ent = tk.Entry(input_frame, width=15)
            burst_ent.grid(row=i+1, column=2, pady=2)
            
            prio_ent = tk.Entry(input_frame, width=15)
            prio_ent.insert(0, "0")
            prio_ent.grid(row=i+1, column=3, pady=2)
            
            process_entries.append({"id": f"P{i+1}", "arrival": arr_ent, "burst": burst_ent, "priority": prio_ent})
    except ValueError:
        messagebox.showerror("Invalid Input", "Please enter a valid positive integer for the number of processes.")

def clear_ui():
