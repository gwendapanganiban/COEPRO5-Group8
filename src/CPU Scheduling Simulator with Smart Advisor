    analysis_box.delete("1.0", tk.END)
    avg_wait.config(text="__________")
    avg_turn.config(text="__________")
    for row in tree.get_children():
        tree.delete(row)
    global current_canvas
    if current_canvas:
        current_canvas.get_tk_widget().destroy()
        current_canvas = None

def extract_process_data():
    data = []
    try:
        for p in process_entries:
            burst_val = int(p["burst"].get())
            if burst_val <= 0:
                raise ValueError("Burst time must be > 0")
            data.append({
                "id": p["id"],
                "arrival": int(p["arrival"].get()),
                "burst": burst_val,
                "priority": int(p["priority"].get()) if p["priority"].get() else 0 
            })
        if not data:
            messagebox.showwarning("No Data", "Please generate and fill process data first.")
            return None
        return data
    except ValueError as e:
        messagebox.showerror("Invalid Data", "Ensure all Arrival and Burst times are valid numbers. Burst must be > 0.")
        return None

def simulate_action():
    data = extract_process_data()
    if not data: return
    
    selected_algo = algorithm.get()
    result = None
    
    if selected_algo == "FCFS":
        result = fcfs(data)
    elif selected_algo == "SJF (Preemptive)":
        result = sjf_preemptive(data)
    elif selected_algo == "Priority (Preemptive)":
        result = priority_preemptive(data)
    elif selected_algo == "Round Robin":
        try:
            tq = int(quantum_entry.get())
            if tq <= 0: raise ValueError
            result = round_robin(data, tq)
        except ValueError:
            messagebox.showerror("Invalid Input", "Please enter a valid positive integer for Time Quantum.")
            return
            
    if result:
        # Populate Treeview
        for row in tree.get_children():
            tree.delete(row)
        for p in result["details"]:
            tree.insert("", "end", values=(p["id"], p["arrival"], p["burst"], p["waiting_time"], p["turnaround_time"]))
        
        # Populate Metrics
        avg_wait.config(text=f"{result['avg_waiting']} units")
        avg_turn.config(text=f"{result['avg_turnaround']} units")
        
        # Render Chart
        draw_gantt_chart(result["timeline"], chart_frame)

def run_advisor():
    data = extract_process_data()
    if not data: return
    
    advice = SmartAdvisor.analyze(data)
    if advice:
        recommend_box.delete("1.0", tk.END)
        recommend_box.insert("1.0", advice["recommended_algorithm"])
        analysis_box.delete("1.0", tk.END)
        analysis_box.insert("1.0", advice["analysis"])

