def draw_gantt_chart(timeline, parent_frame):
    global current_canvas
    if current_canvas:
        current_canvas.get_tk_widget().destroy()

    if not timeline:
        return

    # Create the figure
    fig = Figure(figsize=(10, 2), dpi=100)
    ax = fig.add_subplot(111)

    colors = list(mcolors.TABLEAU_COLORS.values())
    proc_colors = {}
    color_idx = 0
    max_time = 0

    # Draw the bars
    for entry in timeline:
        pid = entry["id"]
        if pid not in proc_colors:
            proc_colors[pid] = colors[color_idx % len(colors)]
            color_idx += 1
            
        start = entry["start"]
        end = entry["end"]
        duration = end - start
        max_time = max(max_time, end)

        ax.barh(0, duration, left=start, color=proc_colors[pid], edgecolor='black')
        # Add process text inside the bar
        ax.text(start + duration/2, 0, pid, ha='center', va='center', color='white', fontweight='bold')

    ax.set_yticks([])
    ax.set_xlim(0, max_time)
    ax.set_xlabel("Time Units")
    ax.set_title("Execution Gantt Chart", fontweight='bold')
    
    # Set xticks properly based on timeline starts and ends
    ticks = sorted(list(set([entry["start"] for entry in timeline] + [entry["end"] for entry in timeline])))
    ax.set_xticks(ticks)
    
    fig.tight_layout()

    # Embed in Tkinter
    current_canvas = FigureCanvasTkAgg(fig, master=parent_frame)
    current_canvas.draw()
    current_canvas.get_tk_widget().pack(fill=tk.BOTH, expand=True)

def generate_inputs():
