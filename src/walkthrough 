class SmartAdvisor:
    @staticmethod
    def analyze(process_list, user_tq=None):
        if not process_list: return None
        
        if user_tq:
            tq = user_tq
        else:
            bursts = [p["burst"] for p in process_list]
            mean_burst = sum(bursts) / len(bursts)
            tq = max(2, int(mean_burst * 0.8))
        
        results = {
            "FCFS": fcfs(process_list),
            "SJF": sjf_non_preemptive(process_list),
            "Priority": priority_non_preemptive(process_list),
            "Round Robin": round_robin(process_list, tq)
        }
        
        scores = {}
        for algo, res in results.items():
            awt = res["avg_waiting"]
            atat = res["avg_turnaround"]
            
            penalty = 0                   <---
            if algo == "Round Robin": penalty += 1.5
            if algo == "Priority": penalty += 2.5 
                
            scores[algo] = (awt * 0.6) + (atat * 0.4) + penalty
            
        best_algo = min(scores, key=lambda k: scores[k]) <---
        
        reasons = {
            "FCFS": "FCFS was chosen because the batch processes arrived sequentially without burst-time variance, neutralizing Convoy Effects.",
            "SJF": f"SJF optimized the system with a minimal Turnaround matrix ({results['SJF']['avg_turnaround']} MS), giving the fastest overall job clearance.",
            "Priority": "Priority execution minimized layout latency for tasks marked critically relevant by infrastructure rules.",
            "Round Robin": f"Round Robin (TQ={tq} MS) achieved optimal response equity and prevented high burst processes from stalling shorter tasks."
        }
        
        return {
            "recommended_algorithm": best_algo,
            "analysis": reasons[best_algo],
            "time_quantum": tq,
            "all_results": results
        }
