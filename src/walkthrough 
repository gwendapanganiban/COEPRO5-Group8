def draw_chart(timeline):
    global ax, fig, canvas_widget
    ax.clear()
    
    c_bg = "#1E293B" if is_dark_mode else "#FFFFFF"
    c_text = "#F8FAFC" if is_dark_mode else "#1E293B"
    c_grid = "#94A3B8" if is_dark_mode else "#64748B"
    
    fig.patch.set_facecolor(c_bg)
    ax.set_facecolor(c_bg)
    
    for spine in ['top', 'right', 'left']: 
        ax.spines[spine].set_visible(False)
    ax.spines['bottom'].set_color(c_text)
    ax.tick_params(axis='x', colors=c_text)
    
    if not timeline: 
        ax.set_yticks([])
        ax.set_xticks([]) 
        ax.spines['bottom'].set_visible(False) 
        canvas_widget.draw()
        return
    else:
        ax.spines['bottom'].set_visible(True) 
    
    distinct_colors = [
        "#EF4444", "#3B82F6", "#10B981", "#F59E0B", "#8B5CF6", "#06B6D4", "#EC4899", "#84CC16",
        "#14B8A6", "#F97316", "#6366F1", "#A855F7", "#D946EF", "#059669", "#DC2626", "#2563EB"
    ]
    
    max_time = 0
    for t in timeline:
        pid = t["id"]
        duration = t["end"] - t["start"]
        
        if pid == "IDLE":                 <---
            color = "#475569" if is_dark_mode else "#CBD5E1"
            label_text = "IDLE"
            text_color = "#94A3B8" if is_dark_mode else "#64748B"
        else:
            try:
                idx = int(pid[1:]) - 1
                color = distinct_colors[idx % len(distinct_colors)]
            except ValueError:
                color = "#888888" 
            label_text = pid
            text_color = "white"
            
        ax.barh(0, duration, left=t["start"], color=color, edgecolor=c_bg, linewidth=1.5, height=0.6, zorder=3) <---
        
        if duration > max_time * 0.02 or len(timeline) < 15:  
            ax.text(t["start"] + duration/2, 0, label_text, ha='center', va='center', color=text_color, fontweight='bold', fontsize=10, zorder=4)
            
        max_time = max(max_time, t["end"])
        
    ax.set_yticks([])
    ax.set_xlim(0, max_time)
    
    xticks = sorted(list(set([t["start"] for t in timeline] + [t["end"] for t in timeline])))
    ax.set_xticks(xticks)
    
    ax.set_xticklabels(xticks, fontsize=10, fontweight='bold', color=c_text) 
    ax.set_xlabel("Timeline Units (MS)", fontsize=11, fontweight='bold', color=c_text, labelpad=5)
    ax.grid(axis='x', linestyle=':', alpha=0.5, color=c_grid, zorder=0)
    fig.subplots_adjust(bottom=0.3, top=0.9, left=0.05, right=0.95)
    canvas_widget.draw()
